RUNNER_HOST=127.0.0.1
RUNNER_PORT=43120
RUNNER_MODE=fake
RUNNER_DATA_DIR=.runner-data
RUNNER_APPROVAL_SECRET=replace-with-at-least-32-random-characters

# Real adapters are opt-in and always use the user's local session.
RUNNER_REAL_PLATFORM=false
BROWSER_EXECUTABLE_PATH=
BOSS_USER_DATA_DIR=.runner-data/sessions/boss
BOSS_CDP_PORT=43121
BOSS_CDP_ENDPOINT=http://127.0.0.1:43121
LIEPIN_MCP_TOKEN=
LIEPIN_MCP_ENDPOINT=https://open-agent.liepin.com/mcp/user

# BOSS evidence selectors require a separately validated page contract.
# No selectors means preflight rejects sending.
BOSS_ACCOUNT_SELECTOR=
BOSS_CONVERSATION_JOB_SELECTOR=
BOSS_CONVERSATION_COMPANY_SELECTOR=
BOSS_CONVERSATION_ROLE_SELECTOR=
BOSS_SENT_MESSAGE_SELECTOR=
# JSON city-name -> platform city-code mapping, taken from the current search UI.
BOSS_CITY_CODES={}
BOSS_MAX_JOBS_PER_PAGE=30
BOSS_DETAIL_DELAY_MIN_MS=700
BOSS_DETAIL_DELAY_MAX_MS=1300
BOSS_RESUME_INDEX=0
BOSS_RESUME_SEND_SELECTOR=
BOSS_RESUME_PANEL_CONFIRM_SELECTOR=
BOSS_RESUME_LIST_SELECTOR=
BOSS_RESUME_ITEM_SELECTOR=
BOSS_RESUME_CONFIRM_SELECTOR=
BOSS_SENT_RESUME_SELECTOR=
