VITE_API_BASE_URL=http://127.0.0.1:18080/api/v1

# Docker Compose development values. Replace them before exposing the stack outside this computer.
POSTGRES_PASSWORD=careerlens_dev_password
RUNNER_APPROVAL_SECRET=replace-with-an-independent-random-string-at-least-32-characters

# The checked-in default remains a deterministic fixture. Use browser/mcp only on your own workstation.
RUNNER_MODE=fake
BOSS_BROWSER_MODE=auto

# BOSS_BROWSER_MODE=auto uses a normal minimized browser after login. Explicit headless mode is
# experimental because BOSS may reject its browser fingerprint with risk-control codes 36/37.
BOSS_SUBMIT_DELAY_MIN_MS=8000
BOSS_SUBMIT_DELAY_MAX_MS=12000
BOSS_SUBMIT_WINDOW_MS=60000
BOSS_SUBMIT_WINDOW_MAX=5
BOSS_BROWSER_RECYCLE_TASKS=40
AMAP_WEB_SERVICE_KEY=

# Core-side encryption key for paired device credentials; generate independently.
# At least 32 random characters. Keep stable or saved device tokens cannot be decrypted.
RUNNER_ENCRYPTION_KEY=
